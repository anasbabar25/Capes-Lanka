# Server
PORT=3001

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=capex_user
DB_PASSWORD=capex_password
DB_DATABASE=capex_lanka

# TypeORM
DB_SYNCHRONIZE=true

# Auth
JWT_SECRET=capex-lanka-secret-change-in-production

# LANKA = Packages Lanka site only; ALL = multi-site (future)
SITE_SCOPE=LANKA

# Set to true after running npm run import:legacy
SKIP_DEMO_SEED=false
